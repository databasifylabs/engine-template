{
  "processes": [
    {"name": "prepare", "type": "oneshot", "enabled": true, "argv": ["install", "-d", "-o", "example", "-g", "example", "-m", "750", "/srv/example/data"]},
    {"name": "server", "enabled": true, "after": ["prepare"], "user": "example", "restart": "always", "restartSec": "2s", "stopTimeout": "30s",
     "argv": ["socat", "TCP-LISTEN:25060,bind=127.0.0.1,reuseaddr,fork", "SYSTEM:echo example ready"]}
  ]
}
